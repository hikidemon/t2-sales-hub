# Server configuration.
# Copy to `.env` in the repository root and adjust. `.env` is git-ignored.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3001

# --- Data source -------------------------------------------------------------
# mock           — synthetic dataset, no external access
# google-sheets  — live Google Sheets (requires the id below)
DATA_SOURCE=mock

# Spreadsheet id of the "Общие" document (the part between /d/ and /edit).
# The sheet must be readable with the link — do NOT make working sheets
# public only to simplify the integration.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_REPORT_GID=515868842
GOOGLE_SHEETS_TIMEOUT_MS=15000

# --- Synchronisation ----------------------------------------------------------
# Interval between automatic synchronisations (5 minutes by default).
SYNC_INTERVAL_MS=300000
SYNC_MAX_RETRIES=3
# A snapshot older than this is reported as stale (15 minutes).
SYNC_STALE_AFTER_MS=900000

# Shared secret for POST /api/sync/refresh.
# When empty the manual refresh endpoint is disabled.
# Generate with: openssl rand -hex 32
SYNC_REFRESH_TOKEN=

# Shared secret for the curator actions of the test module
# (create / publish / archive / statistics).
# When empty the curator actions are disabled.
CURATOR_TOKEN=

# --- Authentication (ABC T2) -------------------------------------------------
# Requires the seller to sign in through the ABC T2 portal.
# false — demo mode, the application works without a login.
AUTH_REQUIRED=false

# Endpoints of the ABC T2 portal.
# The corporate SSO is auth.t2.ru (IdentityServer). The values below are
# taken from its discovery document:
#   https://auth.t2.ru/.well-known/openid-configuration
ABC_T2_AUTHORIZATION_URL=https://auth.t2.ru/connect/authorize
ABC_T2_TOKEN_URL=https://auth.t2.ru/connect/token
ABC_T2_USER_INFO_URL=https://auth.t2.ru/connect/userinfo
# The logout endpoint, for a complete sign-out.
ABC_T2_END_SESSION_URL=https://auth.t2.ru/connect/endsession
# The client of the T2 ID portal — issued together with the redirect URI.
ABC_T2_CLIENT_ID=
ABC_T2_CLIENT_SECRET=
ABC_T2_REDIRECT_URI=http://localhost:3001/api/auth/abc-t2/callback
# The `abc` scope opens access to the data of ABC T2;
# `offline_access` allows renewing the session without a new sign-in.
ABC_T2_SCOPES=openid profile offline_access abc
# client_secret_post (default) or client_secret_basic — both are accepted
# by the provider.
ABC_T2_TOKEN_AUTH_METHOD=client_secret_post

# Session cookie. The secret signs the cookie — the browser cannot
# forge a session id. Generate with: openssl rand -hex 32
AUTH_COOKIE_NAME=t2_session
AUTH_COOKIE_SECRET=
# How long a sign-in lasts, in hours (30 days by default).
AUTH_SESSION_TTL_HOURS=720
# Leave unset to follow NODE_ENV (secure in production).
AUTH_COOKIE_SECURE=

# Where the user lands after signing in and after a refused sign-in.
AUTH_SUCCESS_REDIRECT_URL=http://localhost:5173/
AUTH_FAILURE_REDIRECT_URL=http://localhost:5173/?auth=failed

# Where the sessions are kept. `file` survives a restart of the API, so
# the seller does not have to sign in again. `memory` is for tests.
AUTH_SESSION_STORE=file
AUTH_SESSION_FILE=.data/sessions.json

# The corporate logins that hold the administrator role, separated by
# commas. The role of the portal is never taken away — this only adds.
# Example: AUTH_ADMIN_LOGINS=i.petrova,team.lead@t2.ru
AUTH_ADMIN_LOGINS=

# The corporate logins that hold the curator role, separated by commas.
# Curators create and publish the tests.
AUTH_CURATOR_LOGINS=

# The ways a person may sign in, separated by commas.
#   abc-t2 — the corporate SSO (T2 ID at auth.t2.ru). The strongest:
#            the corporate identity provider authenticates the person.
#   pin    — the fallback that works without any corporate access:
#            name + personal PIN against the employee directory.
# Both may be offered at the same time.
AUTH_METHODS=abc-t2

# The employee directory of the PIN sign-in: names, offices, roles and
# the PIN hashes. It never leaves the server. Relative paths are
# resolved against the root of the project.
AUTH_DIRECTORY_FILE=.data/employees.json

# The access log: who entered, when and from where.
AUTH_ACCESS_LOG=.data/access-log.jsonl

# How many failed sign-in attempts are allowed before the person and
# the address are blocked.
AUTH_PIN_MAX_ATTEMPTS=5

# How long the block lasts, in minutes.
AUTH_PIN_LOCKOUT_MINUTES=15

# --- External systems ---------------------------------------------------------
# The access to ABC T2 and 1C has not been granted yet. When it is,
# add the connection parameters here — never in the frontend code.
# ABC_T2_BASE_URL=
# ABC_T2_CLIENT_ID=
# ABC_T2_CLIENT_SECRET=
# ONEC_BASE_URL=
# ONEC_USERNAME=
# ONEC_PASSWORD=
